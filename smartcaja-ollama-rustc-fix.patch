From d716288c1737f5c977df0da6a6beaa657686b812 Mon Sep 17 00:00:00 2001
From: Cursor Agent <cursoragent@cursor.com>
Date: Wed, 16 Sep 2026 22:10:01 +0000
Subject: [PATCH] fix(desktop): rustc E0308 Command ownership and E0597
 MutexGuard take

Give extract helpers a local `let mut cmd = hidden_command(...); cmd.args(...); run(cmd)` so `run` receives `Command`, not `&mut Command`. Take backend/ollama Mutex slots into locals before `if let Some`.

Apply after palette + portable-ollama, before assets:
git am --3way smartcaja-ollama-rustc-fix.patch
Base: SmartCaja-CCS main after smartcaja-portable-ollama.patch
---
 desktop/src-tauri/src/main.rs | 35 +++++++++++++++++++++++------------
 1 file changed, 23 insertions(+), 12 deletions(-)

diff --git a/desktop/src-tauri/src/main.rs b/desktop/src-tauri/src/main.rs
index 9db9c26..61dad01 100644
--- a/desktop/src-tauri/src/main.rs
+++ b/desktop/src-tauri/src/main.rs
@@ -452,10 +452,9 @@ fn extract_archive(archive: &Path, dest: &Path) -> Result<(), String> {
     };
 
     if name.ends_with(".zip") {
-        let tar = hidden_command("tar")
-            .args(["-xf", &archive_s, "-C", &dest_s])
-            .status();
-        if tar.map(|s| s.success()).unwrap_or(false) {
+        let mut tar = hidden_command("tar");
+        tar.args(["-xf", &archive_s, "-C", &dest_s]);
+        if tar.status().map(|s| s.success()).unwrap_or(false) {
             return Ok(());
         }
         #[cfg(windows)]
@@ -465,14 +464,16 @@ fn extract_archive(archive: &Path, dest: &Path) -> Result<(), String> {
                 archive_s.replace('\'', "''"),
                 dest_s.replace('\'', "''")
             );
