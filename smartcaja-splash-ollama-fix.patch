+<!--
+  PLANTILLA DE SPLASH (editar aqui; no index.html — lo genera configure.mjs)
+
+  En desktop Tauri: se sirve desde FastAPI en /__splash (mismo origen que la app).
+  Tras Ollama: location.replace('/') — sin WebviewWindow.navigate ni invoke.
+  Logo splash: solo el isotipo CCS blanco (brand/logo-ccs-white.png). Un solo logo.
+  splash-mark ya no se usa (el segundo logo 404).
+  Marca: desktop/smartsuite.config.json (SmartCaja, accent #00D53A).
+-->
+<!DOCTYPE html>
+<html lang="es">
+<head>
+  <meta charset="UTF-8" />
+  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
+  <title>{{PRODUCT_NAME}}</title>
+  <link rel="stylesheet" href="ccs-theme.css" />
+  <link rel="stylesheet" href="accent.css" />
+  <style>
+    :root { --navy: var(--ccs-azul-oscuro); --accent: var(--ccs-accent); --gradient: linear-gradient(126.54deg, rgb(0, 215, 0) -3.03%, rgb(0, 86, 202) 56.75%); }
+    * { box-sizing: border-box; margin: 0; padding: 0; }
+    html, body { height: 100%; }
+    body {
+      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
+      background: var(--gradient);
+      color: #fff; display: flex; flex-direction: column; align-items: center;
+      justify-content: center; height: 100vh; text-align: center; gap: 20px; padding: 24px;
+    }
+    .splash-logo { height: 64px; width: auto; max-width: min(280px, 70vw); object-fit: contain; display: block; }
+    .brand { font-size: 34px; font-weight: 800; letter-spacing: 0.5px; }
+    .brand .accent { color: var(--accent); }
+    .sub { color: #c7d3ec; font-size: 14px; max-width: 460px; line-height: 1.5; }
+    .track { width: 300px; max-width: 80vw; height: 8px; border-radius: 8px; overflow: hidden; background: rgba(255,255,255,0.15); position: relative; }
+    .fill { height: 100%; width: 0%; border-radius: 8px; background: var(--gradient); transition: width 0.4s ease; }
+    .track.indeterminate .fill { width: 40% !important; position: absolute; left: -40%; animation: slide 1.2s infinite ease-in-out; }
+    @keyframes slide { 0% { left: -40%; } 100% { left: 100%; } }
+    .status { color: #dbe6ff; font-size: 13px; min-height: 18px; max-width: 460px; }
+    .pct { color: var(--accent); font-weight: 700; font-size: 13px; min-height: 16px; }
+    .enter {
+      margin-top: 12px; padding: 14px 32px; border-radius: 12px; border: 0; cursor: pointer;
+      background: var(--gradient); color: #fff;
+      font-weight: 800; font-size: 18px; opacity: 0; pointer-events: none; transition: opacity 0.3s;
+      box-shadow: 0 4px 20px rgba(0,0,0,0.35);
+    }
+    .enter.show { opacity: 1; pointer-events: auto; }
+    .enter:hover { filter: brightness(1.08); transform: scale(1.02); }
+    .foot { position: absolute; bottom: 18px; color: #9fb2d6; font-size: 11px; }
+    .error {
+      color: #ffcccc; font-size: 15px; font-weight: 600; max-width: 520px; line-height: 1.5;
+      display: none; padding: 12px 16px; background: rgba(80,0,0,0.35); border-radius: 10px;
+      border: 1px solid rgba(255,120,120,0.45);
+    }
+  </style>
+</head>
+<body>
+  {{LOGO_HTML}}
+  <div class="brand">{{BRAND_HTML}}</div>
+  <div class="sub">{{SPLASH_SUBTITLE}}</div>
+  <div class="track indeterminate" id="track"><div class="fill" id="fill"></div></div>
+  <div class="pct" id="pct"></div>
+  <div class="status" id="status">Iniciando servicios...</div>
+  <div class="error" id="error"></div>
+  <button class="enter" id="enter">Entrar ahora</button>
+  <div class="foot">{{PUBLISHER}}</div>
+
+  <script>
+    const statusEl = document.getElementById('status');
+    const pctEl = document.getElementById('pct');
+    const fillEl = document.getElementById('fill');
+    const trackEl = document.getElementById('track');
+    const enterBtn = document.getElementById('enter');
+    const errorEl = document.getElementById('error');
+
+    let navigated = false;
+
+    const onBackendSplash =
+      location.hostname === '127.0.0.1' &&
+      (location.pathname === '/__splash' || location.pathname.startsWith('/__splash/'));
+
+    async function enterApp() {
+      if (navigated) return;
+      if (onBackendSplash) {
+        try {
+          const hr = await fetch('/api/health', { cache: 'no-store' });
+          if (!hr.ok) throw new Error('/api/health status ' + hr.status);
+          navigated = true;
+          statusEl.textContent = 'Abriendo la aplicacion...';
+          window.location.replace('/');
+        } catch (e) {
+          errorEl.textContent =
+            'El servidor no responde (/api/health). Reconstruya backend.exe (build-backend.ps1) y revise %APPDATA%\\SmartCaja\\logs\\ollama.log';
+          errorEl.style.display = 'block';
+        }
+        return;
+      }
+      navigated = true;
+      statusEl.textContent = 'Abriendo la aplicacion...';
+      const t = window.__TAURI__;
+      if (!t || !t.core) return;
+      t.core.invoke('navigate_to_backend').catch((e) => {
+        errorEl.textContent = String(e);
+        errorEl.style.display = 'block';
+        navigated = false;
+      });
+    }
+
+    function render(s) {
+      if (!s) return;
+      if (s.message) statusEl.textContent = s.message;
+      const err = s.backendError ?? s.backend_error;
+      if (err) {
+        errorEl.textContent = err;
+        errorEl.style.display = 'block';
+      } else if (!navigated) {
+        errorEl.style.display = 'none';
+      }
+      if (typeof s.percent === 'number' && s.percent >= 0) {
+        trackEl.classList.remove('indeterminate');
+        fillEl.style.width = s.percent + '%';
+        pctEl.textContent = s.percent + '%';
+      } else {
+        trackEl.classList.add('indeterminate');
+        pctEl.textContent = '';
+      }
+      const done = s.ollamaDone ?? s.ollama_done;
+      const can = s.canContinue ?? s.can_continue;
+      if (done) enterBtn.classList.add('show');
+      if (done && can && !navigated) enterApp();
+    }
+
+    enterBtn.addEventListener('click', enterApp);
+
+    function pollHttpStatus() {
+      if (navigated) return;
+      fetch('/api/desktop-status', { cache: 'no-store' })
+        .then((r) => r.json())
+        .then(render)
+        .catch(() => {});
+    }
+
+    function pollTauriStatus() {
+      const t = window.__TAURI__;
+      if (!t || !t.core || navigated) return;
+      t.core.invoke('current_status').then(render).catch(() => {});
+    }
+
+    if (onBackendSplash) {
+      pollHttpStatus();
+      setInterval(pollHttpStatus, 1000);
+    } else {
+      function initTauri() {
+        const t = window.__TAURI__;
+        if (!t || !t.event || !t.core) return false;
+        pollTauriStatus();
+        t.event.listen('status', (e) => render(e.payload));
+        setInterval(pollTauriStatus, 2000);
+        return true;
+      }
+      if (!initTauri()) {
+        let tries = 0;
+        const iv = setInterval(() => {
+          if (initTauri() || ++tries > 50) clearInterval(iv);
+        }, 100);
+      }
+    }
+  </script>
+</body>
+</html>
