@@ -1178,6 +1178,16 @@ async function loadSettings() {
 
     document.getElementById('settingsContent').innerHTML = `
       <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(300px, 1fr)); gap:16px; margin-top:12px;">
